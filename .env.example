APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-placeholder-not-a-real-key
SUPABASE_SERVER_URL=http://127.0.0.1:54321
GOOGLE_LOGIN_ENABLED=false
PASSWORD_RECOVERY_ENABLED=false
HATIF_ENABLED=false

# Server-only secret shared with the installed KR scheduler. Set at deployment.
KR_SCHEDULER_SECRET=

# Enable only behind a proxy that overwrites incoming X-Forwarded-For.
AUDIT_TRUST_PROXY=false
